+
+def validate_ipc_root(value):
+    root = Path(value)
+    assert root.parent == Path('/tmp') and re.fullmatch(r'bern-input13-[0-9a-f]{12}', root.name)
+    # socket_dir uses 16 hex digits; native new_engine_id uses 8+4+2 hex digits.
+    anticipated = root / ('bern-' + 'f' * 16) / ('f' * 14 + '.sock')
+    assert len(os.fsencode(anticipated)) < 100, 'Anticipated complete Bern socket path must be under100 bytes'
+    return {'root': str(root), 'anticipated_socket': str(anticipated), 'anticipated_socket_bytes': len(os.fsencode(anticipated)), 'required_less_than': 100}
 
 def runtime_environment(lock):
     env = {k: v for k, v in os.environ.items() if not k.startswith('BERN_')}

+          let seconds = expected["tv_sec"] as? NSNumber,
+          let micros = expected["tv_usec"] as? NSNumber,
+          let actual = kernelStart(pid) else { return false }
+    return seconds.uint64Value == actual["tv_sec"] && micros.uint64Value == actual["tv_usec"]
